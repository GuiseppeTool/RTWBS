<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Smart Farming Precision Spraying - V2 (Buffered Execution View)
// Execution-level adaptation: introduces network buffers and jitter.
// This model allows for relaxed reception timing (Delta).

const int N = 2;
const int NUM_TARGETS = 3;  
const int T_identify_min = 1; 
const int T_identify_max = 2; 
const int T_recharge_max = 8; 
const int Delta = 2;        // Admissible relaxation for event reception

typedef int[0,N-1] id_t;

// Channels for buffered communication with the Edge Gateway
chan validate_in[N], validate_out[N]; 

int sector[N] = {0, 1};      
int next_target[N] = {1, 2}; 

bool collisionRisk() {
    return sector[0] == sector[1];
}</declaration>
	<template>
		<name>Drone</name>
		<parameter>id_t id,id_t peer</parameter>
		<declaration>clock x;</declaration>
		<location id="id0" x="-159" y="-1">
			<name x="-249" y="-41">Recharge</name>
			<label kind="invariant" x="-249" y="24">x &lt;= T_recharge_max</label>
		</location>
		<location id="id1" x="200" y="0">
			<name x="190" y="-34">IdentifyTarget</name>
			<label kind="invariant" x="230" y="-12">x &lt;= T_identify_max</label>
		</location>
		<location id="id2" x="526" y="-231">
			<name x="516" y="-265">RequestActuation</name>
			<committed/>
		</location>
		<location id="id3" x="400" y="100">
			<name x="390" y="117">WaitEdgeAuth</name>
		</location>
		<init ref="id0"/>
		<transition id="id4">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="guard" x="-73" y="-61">x &gt;= 1 &amp;&amp; next_target[id] != sector[peer]</label>
			<label kind="assignment" x="-72" y="10">sector[id] = next_target[id], x := 0</label>
		</transition>
		<transition id="id5">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="guard" x="141" y="-166">x &gt;= T_identify_min &amp;&amp; id == 0</label>
		</transition>
		<transition id="id6">
			<source ref="id1"/>
			<target ref="id3"/>
			<label kind="guard" x="64" y="48">x &gt;= T_identify_min &amp;&amp; id == 1</label>
		</transition>
		<transition id="id7">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="guard" x="401" y="-95">id == 0</label>
			<label kind="synchronisation" x="374" y="-73">validate_in[0]!</label>
		</transition>
		<transition id="id8">
			<source ref="id2"/>
			<target ref="id0"/>
			<label kind="guard" x="130" y="-297">id == 1</label>
			<label kind="synchronisation" x="124" y="-270">validate_in[1]!</label>
			<label kind="assignment" x="223" y="-296">next_target[id] = (next_target[id] + 1) % 3, x := 0</label>
			<nail x="96" y="-217"/>
		</transition>
		<transition id="id9">
			<source ref="id3"/>
			<target ref="id2"/>
			<label kind="guard" x="594" y="-75">id == 1</label>
			<label kind="synchronisation" x="590" y="-41">validate_out[0]?</label>
			<nail x="611" y="89"/>
		</transition>
		<transition id="id10">
			<source ref="id3"/>
			<target ref="id0"/>
			<label kind="guard" x="150" y="117">id == 0</label>
			<label kind="synchronisation" x="150" y="134">validate_out[1]?</label>
			<label kind="assignment" x="-45" y="142">next_target[id] = (next_target[id] + 1) % 3, x := 0</label>
			<nail x="-41" y="139"/>
		</transition>
	</template>
	<system>Drone0 = Drone(0,1);
Drone1 = Drone(1,0);
EdgeBus01 = NetworkJitter(validate_in[0], validate_out[0]);
EdgeBus10 = NetworkJitter(validate_in[1], validate_out[1]);
system Drone0, Drone1, EdgeBus01, EdgeBus10;</system>
	<queries>
		<query>
			<formula/>
			<comment/>
		</query>
	</queries>
</nta>
