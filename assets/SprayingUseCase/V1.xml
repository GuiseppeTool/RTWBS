<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
    <declaration>// Smart Farming Precision Spraying - V1 (Abstract Synchronous View)
// Drone coordinates with an Edge Gateway to validate weed detection
// Actuation (Spraying) must occur within a strict deadline after detection

const int N = 2; // Two drones for cooperative area coverage
const int T_identify_min = 1; // Min time to process image locally
const int T_identify_max = 2; // Max time to process image locally
const int T_actuate_max = 5;  // Strict deadline for sprayer actuation
const int T_recharge_max = 8; // Max idle/recharge time

typedef int[0,N-1] id_t;

// Synchronous channels representing idealized immediate edge feedback
chan validate01; // Drone 0 validates with Edge for Sector 1
chan validate10; // Drone 1 validates with Edge for Sector 0

int sector[N] = {0, 1};
int next_target[N] = {1, 2};

// Readiness to communicate with the edge
bool edge_ready[N] = {false, false};

bool collisionRisk() {
    return sector[0] == sector[1];
}</declaration>
    <template>
        <name>Drone</name>
        <parameter>id_t id,id_t peer</parameter>
        <declaration>clock x;</declaration>
        <location id="id0" x="0" y="0">
            <name x="-10" y="-34">Recharge</name>
            <label kind="invariant" x="-10" y="17">x &lt;= T_recharge_max</label>
        </location>
        <location id="id1" x="200" y="0">
            <name x="190" y="-34">IdentifyTarget</name>
            <label kind="invariant" x="190" y="17">x &lt;= T_identify_max</label>
        </location>
        <location id="id2" x="400" y="0">
            <name x="390" y="-34">RequestActuation</name>
            <committed/>
        </location>
        <location id="id3" x="400" y="100">
            <name x="390" y="117">WaitEdgeAuth</name>
            <label kind="invariant" x="390" y="134">x &lt;= T_actuate_max</label>
        </location>
        <init ref="id0"/>
        <transition>
            <source ref="id0"/>
            <target ref="id1"/>
            <label kind="guard" x="50" y="-50">x &gt;= 1 &amp;&amp; next_target[id] != sector[peer]</label>
            <label kind="assignment" x="50" y="-17">sector[id] = next_target[id], x := 0</label>
        </transition>
        <transition>
            <source ref="id1"/>
            <target ref="id2"/>
            <label kind="guard" x="250" y="-34">x &gt;= T_identify_min &amp;&amp; id == 0 &amp;&amp; edge_ready[peer]</label>
        </transition>
        <transition>
            <source ref="id1"/>
            <target ref="id3"/>
            <label kind="guard" x="100" y="50">x &gt;= T_identify_min &amp;&amp; id == 1</label>
            <label kind="assignment" x="100" y="67">edge_ready[id] = true</label>
        </transition>
        <transition>
            <source ref="id2"/>
            <target ref="id3"/>
            <label kind="guard" x="410" y="25">id == 0</label>
            <label kind="synchronisation" x="410" y="42">validate01!</label>
            <label kind="assignment" x="410" y="59">edge_ready[id] = true</label>
        </transition>
        <transition>
            <source ref="id2"/>
            <target ref="id0"/>
            <label kind="guard" x="200" y="-100">id == 1 &amp;&amp; edge_ready[peer]</label>
            <label kind="synchronisation" x="200" y="-83">validate10!</label>
            <label kind="assignment" x="200" y="-66">next_target[id] = (next_target[id] + 1) % 3, 
edge_ready[id] = false, x := 0</label>
            <nail x="200" y="-50"/>
        </transition>
        <transition>
            <source ref="id3"/>
            <target ref="id2"/>
            <label kind="guard" x="450" y="42">id == 1</label>
            <label kind="synchronisation" x="450" y="59">validate01?</label>
            <label kind="assignment" x="450" y="76">edge_ready[id] = false</label>
            <nail x="450" y="50"/>
        </transition>
        <transition>
            <source ref="id3"/>
            <target ref="id0"/>
            <label kind="guard" x="150" y="117">id == 0</label>
            <label kind="synchronisation" x="150" y="134">validate10?</label>
            <label kind="assignment" x="150" y="151">next_target[id] = (next_target[id] + 1) % 3, 
edge_ready[id] = false, x := 0</label>
            <nail x="200" y="150"/>
        </transition>
    </template>
    <system>Drone0 = Drone(0,1);
Drone1 = Drone(1,0);
system Drone0, Drone1;</system>
    <queries>
        <query>
            <formula>A[] not (Drone0.IdentifyTarget &amp;&amp; Drone1.IdentifyTarget &amp;&amp; collisionRisk())</formula>
            <comment>Safety: Drones must not target the same crop area</comment>
        </query>
        <query>
            <formula>A[] not deadlock</formula>
            <comment></comment>
        </query>
    </queries>
</nta>