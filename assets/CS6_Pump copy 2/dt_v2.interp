; Interpretation: GPCA Infusion Pump -- DT v2 (Ontology evolution, domain_v2.ont)
; All formulas reference dose_tolerance symbolically.
; Theorem 1: alignment preserved when dose_tolerance changes from 5 to 3 (Condition II).

; === LOCATION INTERPRETATIONS ===
ICE_DISCONNECTED   : (= dose_delivered 0)
ICE_PRIMING        : (= dose_delivered 0)
ICE_THERAPY_ACTIVE : (and (> primary_rate 0) (<= dose_delivered (+ prescribed_dose dose_tolerance)))
ICE_BOLUS_ACTIVE   : (and (> bolus_volume 0) (<= bolus_volume max_bolus_volume))
ICE_THERAPY_PAUSED : (<= dose_delivered (+ prescribed_dose dose_tolerance))
ICE_KVO_MODE       : (and (= primary_rate kvo_rate) (<= dose_delivered (+ prescribed_dose dose_tolerance)))
ICE_ALARM_OCCLUSION: (> line_pressure occlusion_threshold)
ICE_ALARM_OVERDOSE : (> dose_delivered (+ prescribed_dose dose_tolerance))

; === EVENT INTERPRETATIONS ===
ice_therapy_start!       : (and (> primary_rate 0) (<= primary_rate max_primary_rate))
ice_therapy_pause!       : (and (<= dose_delivered (+ prescribed_dose dose_tolerance)) (= ev_type_id ev_id_pause))
ice_therapy_resume!      : (and (<= dose_delivered (+ prescribed_dose dose_tolerance)) (= ev_type_id ev_id_resume))
ice_safety_limit_breach! : (and (> dose_delivered (+ prescribed_dose dose_tolerance)) (= ev_type_id ev_id_alarm_start))
ice_alarm_ack!           : (and (> dose_delivered (+ prescribed_dose dose_tolerance)) (= ev_type_id ev_id_alarm_ack))
ice_therapy_complete!    : (>= dose_delivered prescribed_dose)
