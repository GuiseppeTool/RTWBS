<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Smart Farming Drone Monitoring System - V1 (Synchronous/Handshake)
// Two drones coordinate to scan farm sectors without overlap
// Communication is strict synchronous handshake (no buffering/delay)

const int N = 2;
const int NUM_SECTORS = 3;  // Farm divided into 3 sectors
const int Tscan_min = 3;    // Minimum scanning time
const int Tscan_max = 5;    // Maximum scanning time  
const int Tidle_max = 8;    // Maximum idle time before next cycle

typedef int[0,N-1] id_t;

// Synchronous channels for position exchange (strict handshake)
chan pos01;  // Drone 0 -&gt; Drone 1
chan pos10;  // Drone 1 -&gt; Drone 0

// Sector assignments
int sector[N] = {0, 1};      // Current sector being scanned
int next_sector[N] = {1, 2}; // Next sector to scan

// Readiness flags: prevent send deadlocks by signaling readiness to receive
bool ready[N] = {false, false};

// Safety helper: check if both drones in same sector
bool sameSector() {
    return sector[0] == sector[1];
}</declaration>
	<template>
		<name>Drone</name>
		<parameter>id_t id,id_t peer</parameter>
		<declaration>clock x;
</declaration>
		<location id="id0" x="0" y="0">
			<name x="-10" y="-34">Idle</name>
			<label kind="invariant" x="-10" y="17">x &lt;= Tidle_max</label>
		</location>
		<location id="id1" x="200" y="0">
			<name x="190" y="-34">Scan</name>
			<label kind="invariant" x="190" y="17">x &lt;= Tscan_max</label>
		</location>
		<location id="id2" x="400" y="0">
			<name x="390" y="-34">SendPos</name>
			<committed/>
		</location>
		<location id="id3" x="400" y="100">
			<name x="390" y="117">WaitPeer</name>
		</location>
		<init ref="id0"/>
		<transition id="id4">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="guard" x="50" y="-50">x &gt;= 1 &amp;&amp; 
next_sector[id] != sector[peer]</label>
			<label kind="assignment" x="50" y="-17">sector[id] = next_sector[id], 
x := 0</label>
		</transition>
		<transition id="id5">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="guard" x="250" y="-34">x &gt;= Tscan_min &amp;&amp; id == 0 &amp;&amp; ready[peer]</label>
		</transition>
		<transition id="id6">
			<source ref="id1"/>
			<target ref="id3"/>
			<label kind="guard" x="100" y="50">x &gt;= Tscan_min &amp;&amp; id == 1</label>
			<label kind="assignment" x="100" y="67">ready[id] = true</label>
		</transition>
		<transition id="id7">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="guard" x="410" y="25">id == 0</label>
			<label kind="synchronisation" x="410" y="42">pos01!</label>
			<label kind="assignment" x="410" y="59">ready[id] = true</label>
		</transition>
		<transition id="id8">
			<source ref="id2"/>
			<target ref="id0"/>
			<label kind="guard" x="200" y="-100">id == 1 &amp;&amp; ready[peer]</label>
			<label kind="synchronisation" x="200" y="-83">pos10!</label>
			<label kind="assignment" x="200" y="-66">next_sector[id] = 
(next_sector[id] + 1) % NUM_SECTORS, 
ready[id] = false,
x := 0</label>
			<nail x="200" y="-50"/>
		</transition>
		<transition id="id9">
			<source ref="id3"/>
			<target ref="id2"/>
			<label kind="guard" x="450" y="42">id == 1</label>
			<label kind="synchronisation" x="450" y="59">pos01?</label>
			<label kind="assignment" x="450" y="76">ready[id] = false</label>
			<nail x="450" y="50"/>
		</transition>
		<transition id="id10">
			<source ref="id3"/>
			<target ref="id0"/>
			<label kind="guard" x="150" y="117">id == 0</label>
			<label kind="synchronisation" x="150" y="134">pos10?</label>
			<label kind="assignment" x="150" y="151">next_sector[id] = 
(next_sector[id] + 1) % NUM_SECTORS, 
ready[id] = false,
x := 0</label>
			<nail x="200" y="150"/>
		</transition>
	</template>
	<system>// Instantiate two drones
Drone0 = Drone(0,1);
Drone1 = Drone(1,0);

system Drone0, Drone1;</system>
	<queries>
		<query>
			<formula>A[] not (Drone0.Scan &amp;&amp; Drone1.Scan &amp;&amp; sameSector())</formula>
			<comment>Safety: Drones must not scan the same sector simultaneously</comment>
			<result outcome="success" type="quality" timestamp="2026-02-16 16:53:01 +0100">
			</result>
		</query>
		<query>
			<formula>Drone0.Idle --&gt; Drone0.Scan</formula>
			<comment>Liveness: Drone0 eventually scans after being idle</comment>
			<result outcome="success" type="quality" timestamp="2026-02-16 16:53:01 +0100">
			</result>
		</query>
		<query>
			<formula>Drone1.Idle --&gt; Drone1.Scan</formula>
			<comment>Liveness: Drone1 eventually scans after being idle</comment>
			<result outcome="success" type="quality" timestamp="2026-02-16 16:53:01 +0100">
			</result>
		</query>
		<query>
			<formula>A[] not deadlock</formula>
			<comment>Deadlock freedom</comment>
			<result outcome="success" type="quality" timestamp="2026-02-16 16:53:01 +0100">
			</result>
		</query>
	</queries>
</nta>
