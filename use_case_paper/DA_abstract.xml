<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Sugar Beet Monitoring - Drone Agent (Deployed / Abstract)
// The drone receives waypoint messages and processes them immediately.
// Anomaly detection triggers a report to the Fleet Coordinator.
// Output deadline: report must be sent within 300ms of anomaly detection.

const int T_DETECT   = 100;  // Max time in monitoring before anomaly detection
const int T_PROC     = 50;   // Max processing time after waypoint reception
const int T_REPORT   = 300;  // Deadline: report within 300ms of anomaly detection
const int T_IDLE_MAX = 200;  // Max idle time before next monitoring cycle

// Channels
chan rcv_waypoint;   // Input:  receive waypoint from FC
chan snd_report;     // Output: send anomaly report to FC</declaration>
	<template>
		<name>DroneAgent</name>
		<declaration>clock x;   // General-purpose clock (reset on transitions)
clock y;   // Anomaly-to-report deadline clock
clock d;   // Duty cycle clock (unused in abstract, present for dimension parity)</declaration>
		<location id="id0" x="0" y="0">
			<name x="-10" y="-34">Idle</name>
			<label kind="invariant" x="-10" y="17">x &lt;= T_IDLE_MAX</label>
		</location>
		<location id="id1" x="200" y="0">
			<name x="190" y="-34">Monitoring</name>
			<label kind="invariant" x="190" y="17">x &lt;= T_DETECT</label>
		</location>
		<location id="id2" x="400" y="0">
			<name x="390" y="-34">RcvWaypoint</name>
			<committed/>
		</location>
		<location id="id3" x="400" y="150">
			<name x="410" y="140">Processing</name>
			<label kind="invariant" x="410" y="157">x &lt;= T_PROC</label>
		</location>
		<location id="id4" x="200" y="150">
			<name x="140" y="140">SendReport</name>
			<label kind="invariant" x="130" y="157">y &lt;= T_REPORT</label>
		</location>
		<init ref="id0"/>
		<!-- Idle -> Monitoring: start monitoring cycle -->
		<transition id="id5">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="guard" x="50" y="-50">x &gt;= 10</label>
			<label kind="assignment" x="50" y="-17">x := 0, y := 0</label>
		</transition>
		<!-- Monitoring -> RcvWaypoint: anomaly detected, waypoint arrives -->
		<transition id="id6">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="guard" x="250" y="-50">x &gt;= 10</label>
			<label kind="synchronisation" x="250" y="-34">rcv_waypoint?</label>
		</transition>
		<!-- RcvWaypoint -> Processing: immediate processing (committed, no delay) -->
		<transition id="id7">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="assignment" x="410" y="50">x := 0</label>
		</transition>
		<!-- Processing -> SendReport: processing complete, ready to send -->
		<transition id="id8">
			<source ref="id3"/>
			<target ref="id4"/>
			<label kind="guard" x="300" y="200">x &gt;= 5</label>
		</transition>
		<!-- SendReport -> Idle: send the anomaly report -->
		<transition id="id9">
			<source ref="id4"/>
			<target ref="id0"/>
			<label kind="synchronisation" x="50" y="100">snd_report!</label>
			<label kind="assignment" x="50" y="117">x := 0</label>
		</transition>
	</template>
	<system>DA = DroneAgent();
system DA;</system>
	<queries>
		<query>
			<formula>A[] not deadlock</formula>
			<comment>Deadlock freedom</comment>
		</query>
		<query>
			<formula>DA.SendReport --&gt; DA.Idle</formula>
			<comment>Liveness: report is eventually sent</comment>
		</query>
	</queries>
</nta>
